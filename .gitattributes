# Standardize everything to Unix line endings
* text=auto eol=lf

# Images as binary
*.jpg *.jpeg *.png *.gif *.svg *.webp binary

# Text-based formats
*.json *.yaml *.yml *.toml *.xml text eol=lf

# Scripts with explicit line endings
*.sh *.bash *.zsh text eol=lf
*.py text eol=lf
*.js *.ts text eol=lf
*.html *.css *.scss text eol=lf
*.md text eol=lf
